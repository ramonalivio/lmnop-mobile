# Copy this file to .env.local for local native app development.
#
# Native OAuth client IDs are public identifiers. Do not put web client secrets
# in the mobile app.

APP_NAME=LMNOP
APP_SLUG=lmnop
APP_URL_SCHEME=lmnop

ANDROID_PACKAGE=com.ramon.lmnop
IOS_BUNDLE_IDENTIFIER=com.example.lmnop

MOBILE_AUTH_START_URL=https://api.example.invalid/mobile/google/start
